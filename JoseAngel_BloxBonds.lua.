-- Variables de control
local AutoFarm = false
local distanciaBusqueda = 250 -- Alcance para buscar bonos

-- Función adaptada a Dead Rails
local function FarmearBonos()
    while AutoFarm and task.wait(1.2) do
        if not Character or not Humanoid or Humanoid.Health <= 0 then continue end

        -- Buscar objetos que otorgan bonos en el mapa
        local bonosEncontrados = {}
        for _, objeto in ipairs(Workspace:GetDescendants()) do
            -- En Dead Rails los bonos suelen tener nombres como "Bond", "Bono", "Money", "Collectible"
            if objeto:IsA("BasePart") and 
               (objeto.Name:lower():find("bond") or objeto.Name:lower():find("moneda") or objeto.Name:lower():find("recompensa")) and
               (objeto.Position - RootPart.Position).Magnitude < distanciaBusqueda then

                table.insert(bonosEncontrados, objeto)
            end
        end

        -- Ordenar por distancia para ir al más cercano primero
        table.sort(bonosEncontrados, function(a, b)
            return (a.Position - RootPart.Position).Magnitude < (b.Position - RootPart.Position).Magnitude
        end)

        -- Recolectar cada uno
        for _, bono in ipairs(bonosEncontrados) do
            if not AutoFarm then break end

            -- Moverse hasta el objeto
            Humanoid:MoveTo(bono.Position)
            Humanoid.MoveToFinished:Wait(3)

            -- Interacción según cómo funciona en Dead Rails
            if bono:FindFirstChild("TouchInterest") then
                -- Si se recoge al tocar, basta con acercarse
                task.wait(0.5)
            else
                -- Si requiere evento remoto
                local eventoRecolectar = ReplicatedStorage:FindFirstChild("Collect") or ReplicatedStorage:FindFirstChild("Pickup")
                if eventoRecolectar and eventoRecolectar:IsA("RemoteEvent") then
                    eventoRecolectar:FireServer(bono)
                end
            end
        end
    end
end

